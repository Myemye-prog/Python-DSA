# 11. Find Second Largest Element
print("11. Second Largest Element")
arr = [10, 20, 4, 45, 99]

largest = second = float('-inf')

for num in arr:
    if num > largest:
        second = largest
        largest = num
    elif num > second and num != largest:
        second = num

print(second)


# 12. Count Even and Odd Numbers
print("\n12. Count Even and Odd")
arr = [1, 2, 3, 4, 5, 6, 7]

even = odd = 0

for num in arr:
    if num % 2 == 0:
        even += 1
    else:
        odd += 1

print("Even:", even)
print("Odd:", odd)


# 13. Sum of Digits
print("\n13. Sum of Digits")
num = 12345
total = 0

while num > 0:
    total += num % 10
    num //= 10

print(total)


# 14. Check Prime Number
print("\n14. Prime Number")
num = 29

if num < 2:
    print("Not Prime")
else:
    prime = True
    for i in range(2, int(num ** 0.5) + 1):
        if num % i == 0:
            prime = False
            break

    if prime:
        print("Prime")
    else:
        print("Not Prime")


