
# ============================================================
# 1. Two Sum
# ============================================================

def two_sum(nums, target):
    seen = {}

    for i, num in enumerate(nums):
        diff = target - num

        if diff in seen:
            return [seen[diff], i]

        seen[num] = i

    return []


# ============================================================
# 2. Find the Missing Number
# ============================================================

def missing_number(nums):
    n = len(nums)

    expected_sum = n * (n + 1) // 2
    actual_sum = sum(nums)

    return expected_sum - actual_sum


# ============================================================
# 3. Find Duplicate Number
# ============================================================

def find_duplicate(nums):
    slow = nums[0]
    fast = nums[0]

    while True:
        slow = nums[slow]
        fast = nums[nums[fast]]

        if slow == fast:
            break

    slow = nums[0]

    while slow != fast:
        slow = nums[slow]
        fast = nums[fast]

    return slow


# ============================================================
# 4. Valid Parentheses
# ============================================================

def is_valid_parentheses(s):
    stack = []
    pairs = {
        ")": "(",
        "}": "{",
        "]": "["
    }

    for char in s:
        if char in pairs.values():
            stack.append(char)

        elif char in pairs:
            if not stack or stack[-1] != pairs[char]:
                return False

            stack.pop()

    return len(stack) == 0


# ============================================================
# 5. First Non-Repeating Character
# ============================================================

def first_unique_char(s):
    count = {}

    for char in s:
        count[char] = count.get(char, 0) + 1

    for i, char in enumerate(s):
        if count[char] == 1:
            return i

    return -1


# ============================================================
# 6. Longest Substring Without Repeating Characters
# ============================================================

def longest_unique_substring(s):
    seen = {}
    left = 0
    max_length = 0

    for right, char in enumerate(s):

        if char in seen and seen[char] >= left:
            left = seen[char] + 1

        seen[char] = right

        max_length = max(max_length, right - left + 1)

    return max_length


# ============================================================
# 7. Check if Two Strings are Anagrams
# ============================================================

def is_anagram(s, t):
    if len(s) != len(t):
        return False

    count = {}

    for char in s:
        count[char] = count.get(char, 0) + 1

    for char in t:

        if char not in count:
            return False

        count[char] -= 1

        if count[char] < 0:
            return False

    return True


# ============================================================
# 8. Move All Zeroes to End
# ============================================================

def move_zeroes(nums):
    index = 0

    for num in nums:
        if num != 0:
            nums[index] = num
            index += 1

    while index < len(nums):
        nums[index] = 0
        index += 1

    return nums


# ============================================================
# 9. Maximum Subarray Sum (Kadane's Algorithm)
# ============================================================

def max_subarray(nums):
    current_sum = nums[0]
    max_sum = nums[0]

    for num in nums[1:]:
        current_sum = max(num, current_sum + num)
        max_sum = max(max_sum, current_sum)

    return max_sum


# ============================================================
# 10. Product of Array Except Self
# ============================================================

def product_except_self(nums):
    n = len(nums)
    result = [1] * n

    prefix = 1

    for i in range(n):
        result[i] = prefix
        prefix *= nums[i]

    suffix = 1

    for i in range(n - 1, -1, -1):
        result[i] *= suffix
        suffix *= nums[i]

    return result


# ============================================================
# 11. Rotate Array by K Positions
# ============================================================

def rotate_array(nums, k):
    n = len(nums)

    k %= n

    return nums[-k:] + nums[:-k]


# ============================================================
# 12. Find Intersection of Two Arrays
# ============================================================

def intersection(nums1, nums2):
    set1 = set(nums1)
    set2 = set(nums2)

    return list(set1 & set2)


# ============================================================
# 13. Majority Element
# Boyer-Moore Voting Algorithm
# ============================================================

def majority_element(nums):
    candidate = None
    count = 0

    for num in nums:

        if count == 0:
            candidate = num

        count += 1 if num == candidate else -1

    return candidate


# ============================================================
# 14. Find Peak Element
# ============================================================

def find_peak(nums):
    left = 0
    right = len(nums) - 1

    while left < right:

        mid = (left + right) // 2

        if nums[mid] > nums[mid + 1]:
            right = mid
        else:
            left = mid + 1

    return left


# ============================================================
# 15. Merge Two Sorted Arrays
# ============================================================

def merge_sorted_arrays(arr1, arr2):
    i = 0
    j = 0
    result = []

    while i < len(arr1) and j < len(arr2):

        if arr1[i] < arr2[j]:
            result.append(arr1[i])
            i += 1
        else:
            result.append(arr2[j])
            j += 1

    result.extend(arr1[i:])
    result.extend(arr2[j:])

    return result


# ============================================================
# 16. Check if Linked List Has Cycle
# ============================================================

class ListNode:

    def __init__(self, value):
        self.value = value
        self.next = None


def has_cycle(head):
    slow = head
    fast = head

    while fast and fast.next:

        slow = slow.next
        fast = fast.next.next

        if slow == fast:
            return True

    return False


# ============================================================
# 17. Reverse a Linked List
# ============================================================

def reverse_linked_list(head):
    previous = None
    current = head

    while current:

        next_node = current.next
        current.next = previous

        previous = current
        current = next_node

    return previous


# ============================================================
# 18. Binary Search
# ============================================================

def binary_search(nums, target):
    left = 0
    right = len(nums) - 1

    while left <= right:

        mid = (left + right) // 2

        if nums[mid] == target:
            return mid

        elif nums[mid] < target:
            left = mid + 1

        else:
            right = mid - 1

    return -1


# ============================================================
# 19. Find Minimum in Rotated Sorted Array
# ============================================================

def find_min_rotated(nums):
    left = 0
    right = len(nums) - 1

    while left < right:

        mid = (left + right) // 2

        if nums[mid] > nums[right]:
            left = mid + 1
        else:
            right = mid

    return nums[left]


# ============================================================
# 20. Next Greater Element
# ============================================================

def next_greater_element(nums):
    stack = []
    result = [-1] * len(nums)

    for i in range(len(nums)):

        while stack and nums[i] > nums[stack[-1]]:
            index = stack.pop()
            result[index] = nums[i]

        stack.append(i)

    return result


