# ============================================================
# 1. TRAPPING RAIN WATER
# ============================================================
# Given an array representing heights of buildings,
# calculate how much rain water can be trapped.
#
# Example:
# Input:  [0,1,0,2,1,0,1,3,2,1,2,1]
# Output: 6
#
# Challenge:
# Solve it in O(n) time and O(1) extra space.


# ============================================================
# 2. LONGEST CONSECUTIVE SEQUENCE
# ============================================================
# Given an unsorted array of integers, find the length
# of the longest consecutive sequence.
#
# Example:
# Input:  [100,4,200,1,3,2]
# Output: 4
#
# Explanation:
# Longest sequence = [1,2,3,4]
#
# Challenge:
# Time complexity should be O(n).


# ============================================================
# 3. MINIMUM WINDOW SUBSTRING
# ============================================================
# Given two strings s and t, find the smallest substring
# of s that contains every character of t.
#
# Example:
# Input:
# s = "ADOBECODEBANC"
# t = "ABC"
#
# Output:
# "BANC"
#
# Challenge:
# Use sliding window.


# ============================================================
# 4. SUBARRAY WITH MAXIMUM SUM
# ============================================================
# Given an integer array, find the contiguous subarray
# with the maximum sum.
#
# Example:
# Input:  [-2,1,-3,4,-1,2,1,-5,4]
# Output: 6
#
# Explanation:
# [4,-1,2,1] has maximum sum = 6
#
# Extra challenge:
# Also print the actual subarray.


# ============================================================
# 5. THREE SUM
# ============================================================
# Given an integer array, find all unique triplets
# whose sum is equal to 0.
#
# Example:
# Input:
# [-1,0,1,2,-1,-4]
#
# Output:
# [
#     [-1,-1,2],
#     [-1,0,1]
# ]
#
# Challenge:
# Avoid duplicate triplets.
# Target complexity: O(n²).


# ============================================================
# 6. NEXT GREATER ELEMENT
# ============================================================
# For every element in an array, find the next element
# to its right that is greater.
#
# Example:
# Input:
# [4,5,2,10,8]
#
# Output:
# [5,10,10,-1,-1]
#
# Challenge:
# Solve using a stack in O(n).


# ============================================================
# 7. LARGEST RECTANGLE IN HISTOGRAM
# ============================================================
# Given an array representing heights of histogram bars,
# find the area of the largest rectangle.
#
# Example:
# Input:
# [2,1,5,6,2,3]
#
# Output:
# 10
#
# Explanation:
# Bars [5,6] create rectangle:
# height = 5
# width = 2
# area = 10
#
# Challenge:
# Use a monotonic stack.


# ============================================================
# 8. SLIDING WINDOW MAXIMUM
# ============================================================
# Given an array and window size k, find the maximum
# element in every sliding window.
#
# Example:
# Input:
# nums = [1,3,-1,-3,5,3,6,7]
# k = 3
#
# Output:
# [3,3,5,5,6,7]
#
# Challenge:
# Target complexity: O(n).


# ============================================================
# 9. REVERSE A LINKED LIST IN GROUPS
# ============================================================
# Given a linked list, reverse its nodes in groups of k.
#
# Example:
# Input:
# 1 -> 2 -> 3 -> 4 -> 5
# k = 2
#
# Output:
# 2 -> 1 -> 4 -> 3 -> 5
#
# If the remaining nodes are fewer than k,
# keep them unchanged.
#
# Challenge:
# Do it without creating another linked list.


# ============================================================
# 10. DETECT AND REMOVE LOOP IN LINKED LIST
# ============================================================
# Given a linked list, determine whether it contains
# a cycle.
#
# If a cycle exists:
# 1. Detect the cycle.
# 2. Find where the cycle begins.
# 3. Remove the cycle.
#
# Challenge:
# Use Floyd's Cycle Detection Algorithm.
#
# Do not use a set or extra data structure.


# ============================================================
# 11. LOWEST COMMON ANCESTOR OF BINARY TREE
# ============================================================
# Given a binary tree and two nodes p and q,
# find their Lowest Common Ancestor (LCA).
#
# Example:
#
#          3
#        /   \
#       5     1
#      / \   / \
#     6   2 0   8
#
# p = 5
# q = 1
#
# Output:
# 3
#
# Challenge:
# Solve recursively.


# ============================================================
# 12. DIAMETER OF A BINARY TREE
# ============================================================
# Find the diameter of a binary tree.
#
# Diameter = longest path between any two nodes.
#
# Example:
#
#          1
#         / \
#        2   3
#       / \
#      4   5
#
# Output:
# 3
#
# Explanation:
# Longest path:
# 4 -> 2 -> 1 -> 3
#
# Challenge:
# Solve in O(n).


