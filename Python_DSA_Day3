# Frequency counting
ls = [1, 2, 3, 4, 5, 3, 2, 6, 7, 8, 4]

frequency = {}

for i in ls:
    if i in frequency:
        frequency[i] = frequency[i] + 1
    else:
        frequency[i] = 1

print(frequency)
